---
interface Props {
  title: string;
  summary: string;
  icon: 'strategy' | 'implementation' | 'support';
  ctaLabel: string;
  ctaHref: string;
}
const { title, summary, icon, ctaLabel, ctaHref } = Astro.props;
---
<div class="service-card">
  <svg viewBox="0 0 42 42" class="icon" aria-hidden="true" fill="none" stroke="#E90008">
    {icon === 'strategy' && (
      <>
        <circle cx="21" cy="21" r="15" stroke-width="2"/>
        <circle cx="21" cy="21" r="8.5" stroke-width="2"/>
        <circle cx="21" cy="21" r="2.2" fill="#E90008" stroke="none"/>
      </>
    )}
    {icon === 'implementation' && (
      <>
        <rect x="8" y="12" width="17" height="17" rx="2.5" stroke-width="2" transform="rotate(-8 16.5 20.5)"/>
        <rect x="16" y="14" width="17" height="17" rx="2.5" stroke-width="2" transform="rotate(8 24.5 22.5)"/>
      </>
    )}
    {icon === 'support' && (
      <>
        <path d="M21 6l13 6v10c0 8-5.5 12.8-13 14-7.5-1.2-13-6-13-14V12l13-6z" stroke-width="2" stroke-linejoin="round"/>
        <path d="M16 21l4 4 7-8" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
      </>
    )}
  </svg>
  <h3>{title}</h3>
  <p>{summary}</p>
  <a href={ctaHref}>{ctaLabel}</a>
</div>

<style>
  .service-card {
    position: relative;
    background: #fff;
    border: 1px solid #cfd8dc;
    padding: 34px 30px;
    min-height: 250px;
    overflow: hidden;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .service-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .service-card:hover {
    border-color: var(--red);
    background: var(--tint);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }

  .service-card:hover::before {
    transform: scaleX(1);
  }

  .icon {
    width: 40px;
    height: 40px;
    margin-bottom: 20px;
  }

  .service-card h3 {
    font-size: 19px;
    margin-bottom: 10px;
  }

  .service-card p {
    color: var(--grey);
    font-size: 14.5px;
    margin-bottom: 18px;
  }

  .service-card a {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--red);
    border-bottom: 1px solid var(--red);
    padding-bottom: 2px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .service-card a:hover {
    color: var(--red-dark);
    border-color: var(--red-dark);
  }

  .service-card:focus-within {
    border-color: var(--red);
  }
</style>