---
<footer>
  <div class="wrap foot-top">
    <div class="foot-brand">
      <span class="brand-name">notio</span>
      <p>An SAP solutions partner for businesses that want a system built around how they actually work.</p>
    </div>
    <div class="foot-col">
      <h5>Company</h5>
      <a href="/careers">Careers</a>
      <a href="/contact">Contact Us</a>
      <a href="/events">Events</a>
      <a href="/about">About Us</a>
      <a href="/blog">Blogs</a>
    </div>
    <div class="foot-col">
      <h5>Legal</h5>
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/cookies-policy">Cookies Policy</a>
      <a href="/modern-slavery">Modern Slavery Statement</a>
      <a href="/terms">Terms &amp; Conditions</a>
    </div>
    <div class="foot-col foot-actions">
      <a href="/academy" class="btn btn-primary">Academy</a>
      <div class="socials">
        {social.map((s) => (
          <a href={s.href} aria-label={s.label} target="_blank" rel="noopener">
            <svg viewBox={s.viewBox} aria-hidden="true"><path d={s.path}/></svg>
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="wrap foot-bottom">
    <span>&copy; {year} Notio Technology. All rights reserved.</span>
  </div>
</footer>

<style>
  footer{ background:var(--black); color:#C9C9C9; padding:56px 0 26px;  }
  .foot-top{ display:flex; gap:48px; flex-wrap:wrap; padding-bottom:34px; border-bottom:1px solid rgba(255,255,255,0.12); }
  .foot-brand{ flex:1 1 220px; }
  .foot-brand .brand-name{ font-family:'Inter',sans-serif; font-weight:800; font-size:22px; color:#fff; }
  .foot-brand p{ margin-top:12px; max-width:280px; font-size:13.5px; color:#9A9A9A; }
  .foot-col h5{ font-size:12.5px; color:#fff; font-weight:700; letter-spacing:.05em; text-transform:uppercase; margin-bottom:14px; }
  .foot-col a{ display:block; font-size:13.5px; color:#B4B4B4; padding:5px 0; }
  .foot-col a:hover{ color:#fff; }
  .foot-actions{ display:flex; flex-direction:column; align-items:flex-start; gap:20px; }
  .foot-actions .btn{ padding:10px 22px; font-size:13px; }
  .socials{ display:flex; gap:14px; }
  .socials a{ display:flex; }
  .socials svg{ width:16px; height:16px; fill:#B4B4B4; }
  .socials a:hover svg{ fill:var(--red); }
  .foot-bottom{ padding-top:22px; font-size:12.5px; color:#7A7A7A; }
</style>
