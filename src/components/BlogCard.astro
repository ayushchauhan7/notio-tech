---
interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
}
const { slug, title, description, pubDate, tags } = Astro.props;
const formatted = pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<a class="blog-card" href={`/blog/${slug}`}>
  {tags[0] && <span class="tag">{tags[0]}</span>}
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="date">{formatted}</span>
</a>

<style>
  .blog-card {
    position: relative;
    display: block;
    border: 1px solid var(--line);
    padding: 26px 24px;
    background: #fff;
    overflow: hidden;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .blog-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .blog-card:hover {
    border-color: var(--red);
    background: var(--tint);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }

  .blog-card:hover::before {
    transform: scaleX(1);
  }

  .tag {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    color: var(--red);
    text-transform: uppercase;
    letter-spacing: .05em;
    margin-bottom: 12px;
  }

  .blog-card h3 {
    font-style: normal;
    color: var(--black);
    font-family: 'Inter', sans-serif;
    font-size: 17px;
    margin-bottom: 10px;
    transition: color 0.15s ease;
  }

  .blog-card:hover h3 {
    color: var(--red);
  }

  .blog-card p {
    color: var(--grey);
    font-size: 14px;
    margin-bottom: 16px;
  }

  .date {
    font-size: 12.5px;
    color: #8A8A8A;
  }

  .blog-card:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }
</style>
