---
---

<header>
  <div class="wrap nav">
    <a href="/" class="brand" aria-label="Notio Technologies home">
      <img src="/notio-logo.png" class="brand-logo" alt="Notio Technologies" />
    </a>

    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" type="button">
      <span></span>
    </button>

    <nav class="nav-links" aria-label="Main navigation">
      <a class="main-link" href="/careers">Careers</a>
      <a class="main-link" href="/contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #fff;
    border-bottom: 1px solid var(--line);
  }

  .wrap.nav {
    width: 100%;
    max-width: 95%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-logo {
    width: 190px;
    height: auto;
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 2px;
    min-width: 0;
  }

  .main-link {
    display: flex;
    align-items: center;
    background: none;
    border: 0;
    color: var(--black);
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    padding: 14px 10px;
    white-space: nowrap;
  }

  .main-link:hover {
    color: var(--red);
  }

  .nav-toggle {
    display: none;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 8px 0 8px 8px;
    flex-shrink: 0;
  }

  .nav-toggle span,
  .nav-toggle span::before,
  .nav-toggle span::after {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--black);
    position: relative;
    transition: 0.2s;
  }

  .nav-toggle span::before,
  .nav-toggle span::after {
    content: '';
    position: absolute;
  }

  .nav-toggle span::before { top: -7px; }
  .nav-toggle span::after { top: 7px; }

  @media (max-width: 1050px) {
    .nav { padding: 14px 16px; }
    .nav-toggle { display: block; }

    .nav-links {
      position: fixed;
      top: 58px;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      box-sizing: border-box;
      background: #fff;
      overflow-y: auto;
      overflow-x: hidden;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0;
      padding: 8px 24px 40px;
      border-top: 1px solid var(--line);
      transform: translateY(-110%);
      transition: transform 0.25s ease;
      z-index: 99;
    }

    .nav-links.open { transform: translateY(0); }

    .main-link {
      width: 100%;
      padding: 16px 0;
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 720px) {
    .wrap.nav { max-width: 100%; }
    .nav { padding: 14px 20px; }
    .brand-logo { width: 170px; }
    .nav-links {
      top: 55px;
      padding-left: 20px;
      padding-right: 20px;
    }
  }

  @media (max-width: 400px) {
    .nav { padding-left: 16px; padding-right: 16px; }
    .brand-logo { width: 150px; }
    .nav-links { padding-left: 16px; padding-right: 16px; }
  }
</style>

<script>
  const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const navLinks = document.querySelector<HTMLElement>('.nav-links');

  navToggle?.addEventListener('click', () => {
    const isOpen = navLinks?.classList.toggle('open');
    navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 1050) {
      navLinks?.classList.remove('open');
      navToggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
