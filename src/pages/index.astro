---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection, getEntry, render } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const introEntry = await getEntry('site', 'intro');
const confidenceEntry = await getEntry('site', 'confidence');
const ctaEntry = await getEntry('site', 'cta');
const { Content: ConfidenceBody } = confidenceEntry ? await render(confidenceEntry) : { Content: null };

const trio = [
  { label: 'OUR EXPERTISE', title: 'Technology expertise that delivers', copy: 'We bring together expertise across IT consulting, SAP and enterprise applications, software development, system integration, and application support to help businesses build reliable, scalable technology solutions.' },
  { label: 'OUR APPROACH', title: 'Solutions designed around your business', copy: "We begin by understanding your business goals, processes, and challenges. Then we develop practical technology solutions that align with your needs, improve efficiency, and support long-term growth." },
  { label: 'OUR COMMITMENT', title: 'Focused on lasting value', copy: 'Our focus goes beyond implementation. We help businesses improve operations, optimize technology investments, and maintain solutions that adapt to changing requirements and evolving business needs.' },
];

const industries = ['Manufacturing', 'Pharmaceuticals & Life Sciences', 'FMCG', 'Automotive', 'Chemicals', 'Media & Entertainment', 'Information Technology', 'Retail & E-commerce', 'Logistics & Supply Chain', 'Energy & Utilities', 'Telecommunications', 'Banking & Financial Services', 'Healthcare', 'Public Sector', 'Education'];

const clients = [
  {
    industry: 'FOOTWEAR MANUFACTURING',
    name: 'Aqualite',
    description: 'Supporting business operations through enterprise technology solutions and technology consulting aligned with manufacturing requirements.',
  },
  {
    industry: 'TECHNOLOGY & WORKFORCE SOLUTIONS',
    name: 'Quess',
    description: 'Supporting technology and business requirements through technical expertise, enterprise solutions, and consulting services.',
  },
  {
    industry: 'IT SERVICES & CONSULTING',
    name: 'Systems Plus',
    description: 'Contributing technology expertise and consulting support to meet enterprise application and business technology requirements.',
  },
];

---
<BaseLayout title="SAP Solutions and Services" description="Notio Technology Pvt. Ltd. provides SAP implementation, migration, integration, advisory, and application management services.">
  <Hero />

  <section class="trio">
    <div class="wrap trio-grid">
      {trio.map((item) => (
        <div class="trio-item">
          <span class="eyebrow">{item.label}</span>
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
        </div>
      ))}
    </div>
  </section>

  {introEntry && (
    <section class="tint">
      <div class="wrap section-head">
        <h2>{introEntry.data.title}</h2>
        {introEntry.data.subtitle && <p>{introEntry.data.subtitle}</p>}
      </div>
    </section>
  )}

  {confidenceEntry && (
    <section id="about">
      <div class="wrap confidence">
        <h2>{confidenceEntry.data.title}</h2>
        <div class="confidence-body">{ConfidenceBody && <ConfidenceBody />}</div>
      </div>
    </section>
  )}

  <section id="services" class="tint">
    <div class="wrap">
      <div class="section-head">
        <h2>Technology services for your business</h2>
        <p>From IT consulting and software development to enterprise applications, system integration, and ongoing support, we help businesses build, modernise, and manage technology solutions that drive operational efficiency and long-term growth.</p>
      </div>
      <div class="grid-3">
        {services.map((s) => (
          <ServiceCard title={s.data.title} summary={s.data.summary} icon={s.data.icon} ctaLabel={s.data.ctaLabel} ctaHref={s.data.ctaHref} />
        ))}
      </div>
    </div>
  </section>

  <section id="industries">
    <div class="wrap">
      <div class="section-head">
        <h2>Industries we serve</h2>
        <p>We work with businesses across diverse industries, combining technology expertise and business understanding to deliver solutions that address operational challenges, improve efficiency, and support sustainable growth.</p>
      </div>
      <div class="industry-grid">
        {industries.map((name) => <div class="industry-chip">{name}</div>)}
      </div>
    </div>
  </section>

  {posts.length > 0 && (
   <section class="tint">
  <div class="wrap">
    <div class="section-head">
      <h2>Our Clients</h2>
      <p>We value the relationships we build with organisations that rely on technology to improve operations, address business challenges, and support growth.</p>
    </div>

    <div class="grid-3">
      {clients.map((client) => (
        <div class="client-card">
          <span class="tag">{client.industry}</span>
          <h3>{client.name}</h3>
          <p>{client.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
  )}

  {ctaEntry && (
    <section class="cta-band">
      <div class="wrap cta-inner">
        <div>
          <h2>{ctaEntry.data.title}</h2>
          {ctaEntry.data.subtitle && <p>{ctaEntry.data.subtitle}</p>}
        </div>
        <a href="/contact" class="btn btn-primary">Let's Talk Business →</a>
      </div>
    </section>
  )}
</BaseLayout>

<style>

.client-card {
  position: relative;
  display: block;
  border: 1px solid var(--line);
  padding: 26px 24px;
  background: #fff;
  overflow: hidden;
  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.client-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 3px;
  background: var(--red);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.2s ease;
}

.client-card:hover {
  border-color: var(--red);
  background: var(--tint);
  transform: translateY(-3px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

.client-card:hover::before {
  transform: scaleX(1);
}

.client-card .tag {
  display: inline-block;
  margin-bottom: 12px;
  color: var(--red);
  font-size: 11.5px;
  font-weight: 700;
  letter-spacing: .05em;
  text-transform: uppercase;
}

.client-card h3 {
  margin-bottom: 10px;
  color: var(--black);
  font-family: 'Inter', sans-serif;
  font-size: 17px;
}

.client-card:hover h3 {
  color: var(--red);
}

.client-card p {
  color: var(--grey);
  font-size: 14px;
}

  .trio{ padding:88px 0; }
  .trio-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
  .trio-item{
    position:relative; overflow:hidden;
    background:var(--tint); border:1px solid var(--line); border-radius:6px;
    padding:40px 32px 36px;
    box-shadow:0 4px 14px rgba(0,0,0,0.04);
    transition:transform .18s ease, box-shadow .18s ease;
  }
  .trio-item::before{
    content:''; position:absolute; top:0; left:0; right:0; height:4px; background:var(--red);
  }
  .trio-item:hover{ transform:translateY(-4px); box-shadow:0 14px 28px rgba(0,0,0,0.09); }
  .trio-item .eyebrow{ margin-bottom:10px; }
  .trio-item h3{ font-size:20px; margin:8px 0 12px; }
  .trio-item p{ color:var(--grey); font-size:14.5px; }
  @media (max-width:820px){
    .trio-grid{ grid-template-columns:1fr; }
  }

  .confidence{ max-width:820px; margin:0 auto; }
  .confidence h2{ text-align:center; margin-bottom:36px; }
  .confidence-body :global(p){ color:var(--grey); margin-bottom:16px; font-size:16px; }
  .confidence-body :global(ul){ margin:16px 0 0 4px; display:grid; grid-template-columns:1fr 1fr; gap:8px; }
  .confidence-body :global(li){ font-size:15px; color:var(--ink); padding-left:18px; position:relative; }
  .confidence-body :global(li::before){ content:'\2713'; color:var(--red); position:absolute; left:0; font-weight:700; }

.industry-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14px;
  margin-top: 32px;
}

.industry-chip {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;

  min-height: 72px;
  padding: 18px 20px;

  box-sizing: border-box;

  background: #fff;

  border: 1px solid var(--line);
  border-radius: 2px;

  color: var(--black);

  font-size: 14px;
  font-weight: 650;
  line-height: 1.3;
  text-align: center;

  cursor: pointer;

  transition:
    border-color .2s ease,
    background-color .2s ease,
    color .2s ease,
    transform .2s ease,
    box-shadow .2s ease;
}

/* Small red accent at the top */
.industry-chip::before {
  content: '';

  position: absolute;

  top: -1px;
  left: -1px;
  right: -1px;

  height: 3px;

  background: var(--red);

  transform: scaleX(0);
  transform-origin: left;

  transition: transform .2s ease;
}

/* Hover */
.industry-chip:hover {
  border-color: var(--red);

  background: var(--tint);

  color: var(--red);

  transform: translateY(-3px);

  box-shadow:
    0 8px 20px rgba(0, 0, 0, 0.07);
}

.industry-chip:hover::before {
  transform: scaleX(1);
}

/* Keyboard accessibility */
.industry-chip:focus-visible {
  outline: 2px solid var(--red);
  outline-offset: 3px;
}


/* Tablet */
@media (max-width: 900px) {
  .industry-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}


/* Mobile */
@media (max-width: 560px) {
  .industry-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .industry-chip {
    min-height: 64px;
    padding: 16px 12px;
    font-size: 14px;
  }
}


/* Very small screens */
@media (max-width: 380px) {
  .industry-grid {
    grid-template-columns: 1fr;
  }
}
  .cta-band{ background:var(--black); color:#fff; }
  .cta-inner{ display:flex; justify-content:space-between; align-items:center; gap:24px; flex-wrap:wrap; }
  .cta-inner h2{ color:#fff; font-size:28px; max-width:480px; }
  .cta-inner p{ color:#fff; margin-top:10px; }
</style>
