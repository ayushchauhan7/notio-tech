---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Blog" description="Notes on SAP strategy, implementation, and support from the Notio Technology team.">
  <section class="hero-strip">
    <div class="wrap">
      <h1>Blog</h1>
      <p>Notes on SAP strategy, implementation, and keeping a landscape healthy after go-live.</p>
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="grid-3">
        {posts.map((p) => (
          <BlogCard slug={p.id} title={p.data.title} description={p.data.description} pubDate={p.data.pubDate} tags={p.data.tags} />
        ))}
      </div>
      {posts.length === 0 && <p class="empty">No posts yet, add markdown files to src/content/blog.</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .hero-strip{ padding:56px 0 20px; }
  .hero-strip p{ color:var(--grey); margin-top:12px; max-width:520px; }
  .empty{ color:var(--grey); }
</style>
