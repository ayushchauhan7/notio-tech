---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formatted = post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="wrap post">
    <a href="/blog" class="back">&larr; Back to blog</a>
    {post.data.tags[0] && <span class="tag">{post.data.tags[0]}</span>}
    <h1>{post.data.title}</h1>
    <p class="meta">{formatted} &middot; {post.data.author}</p>
    <div class="body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post{ max-width:720px; padding-top:56px; padding-bottom:80px; }
  .back{ font-size:13.5px; font-weight:600; color:var(--grey); display:inline-block; margin-bottom:24px; }
  .back:hover{ color:var(--red); }
  .tag{ display:inline-block; font-size:11.5px; font-weight:700; color:var(--red); text-transform:uppercase; letter-spacing:.05em; margin-bottom:14px; }
  h1{ font-size:36px; }
  .meta{ color:#8A8A8A; font-size:13.5px; margin:14px 0 36px; }
  .body :global(h2){ font-style:normal; color:var(--black); font-family:'Inter',sans-serif; font-size:22px; margin:34px 0 12px; }
  .body :global(p){ color:var(--ink); font-size:16.5px; margin-bottom:16px; }
</style>
