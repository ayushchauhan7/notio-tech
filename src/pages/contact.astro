---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Get in touch with Notio Technology.">
  <section class="contact">
    <div class="wrap contact-grid">
      <div>
        <h1>Let's Talk</h1>
        <p class="lede">Have a technology challenge or a new project in mind? Connect with Notio Technologies to explore solutions across IT consulting, enterprise applications, software development, system integration, and ongoing technology support.</p>
        <div class="info-line"><strong>Address</strong><span>214, Aggarwal Tower, Plot No. 7&8, IP Extension, East Delhi, Delhi-110092, India</span></div>
        <div class="info-line"><strong>Phone</strong><span><a href="tel:+919818330675">+91 98183  30675</a> · <a href="tel:+918178817619">+91 8178817619</a></span></div>
        <div class="info-line"><strong>Email</strong><span><a href="mailto:info@notio-tech.com">info@notio-tech.com</a></span></div>
        <!-- <div class="info-line"><strong>Hours</strong><span>09:00 &ndash; 18:00</span></div> -->
      </div>
      <form id="contact-form" action="https://formspree.io/f/xrpedvzd" method="POST">
        <div class="row2">
          <input type="text" name="name" placeholder="Full name" autocomplete="name" required />
          <input type="email" name="email" placeholder="Work email" autocomplete="email" required />
        </div>
        <input type="text" name="company" placeholder="Company Name" autocomplete="organization" />
        <input type="text" name="service" placeholder="Service of Interest" />
        <textarea name="message" placeholder="Tell us about your project or requirements"></textarea>
        <input type="hidden" name="_subject" value="New enquiry from Notio Technology website" />
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" hidden />
        <button type="submit" class="btn btn-primary">Send Enquiry →</button>
        <p class="note" id="note" role="status" aria-live="polite" hidden></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const note = document.getElementById('note');

    button.disabled = true;
    button.textContent = 'Sending…';
    note?.setAttribute('hidden', '');

    try {
      const response = await fetch(form.action, {
        method: form.method,
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (!response.ok) {
        throw new Error('Form submission failed');
      }

      form.reset();
      if (note) {
        note.textContent = 'Thanks, your enquiry has been sent. We will get back to you soon.';
        note.removeAttribute('hidden');
      }
    } catch {
      if (note) {
        note.textContent = 'We could not send your enquiry. Please try again or email info@notio-tech.com directly.';
        note.removeAttribute('hidden');
      }
    } finally {
      button.disabled = false;
      button.textContent = 'Send Enquiry →';
    }
  });
</script>

<style>
  .contact{ padding-top:56px; }
  .contact-grid{ display:grid; grid-template-columns:1fr 1fr; gap:64px; }
  @media (max-width:860px){ .contact-grid{ grid-template-columns:1fr; gap:40px; } }
  h1{ font-size:34px; }
  .lede{ color:var(--grey); margin:16px 0 28px; }
  .info-line{ display:flex; gap:14px; padding:14px 0; border-top:1px solid var(--line); font-size:14.5px; }
  .info-line strong{ min-width:100px; color:var(--black); font-family:'Inter',sans-serif; }
  .info-line span{ color:var(--grey); }
  form{ display:flex; flex-direction:column; gap:14px; }
  .row2{ display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  @media (max-width:520px){ .row2{ grid-template-columns:1fr; } }
  input, textarea{
    border:1px solid var(--line); padding:13px 14px; font-family:inherit; font-size:14.5px;
    border-radius:var(--radius); background:var(--tint);
  }
  input:focus, textarea:focus{ outline:2px solid var(--red); outline-offset:1px; background:#fff; }
  textarea{ min-height:110px; resize:vertical; }
  form button{ align-self:flex-start; border:none; cursor:pointer; margin-top:4px; }
  .note{ font-size:12.5px; color:var(--grey); }
</style>
