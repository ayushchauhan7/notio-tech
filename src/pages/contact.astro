---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Get in touch with Notio Technology.">
  <section class="contact">
    <div class="wrap contact-grid">
      <div>
        <h1>Contact us</h1>
        <p class="lede">Tell us where things stand today, and we'll come back with how we'd approach it, no generic pitch decks.</p>
        <div class="info-line"><strong>Company</strong><span>Notio Technology</span></div>
        <div class="info-line"><strong>Hours</strong><span>Monday &ndash; Friday, 09:00 &ndash; 17:00</span></div>
        <div class="info-line"><strong>Focus</strong><span>SAP implementation, migration &amp; managed support</span></div>
        <div class="info-line"><strong>Response</strong><span>Within one business day</span></div>
      </div>
      <form id="contact-form">
        <div class="row2">
          <input type="text" placeholder="Full name" required />
          <input type="email" placeholder="Work email" required />
        </div>
        <input type="text" placeholder="Company" />
        <textarea placeholder="What are you looking to solve?"></textarea>
        <button type="submit" class="btn btn-primary">Send message</button>
        <p class="note" id="note" hidden>Thanks, this is a static demo form, so nothing was actually sent. Wire it up to your backend or a form service to go live.</p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    (e.target as HTMLFormElement).reset();
    document.getElementById('note')?.removeAttribute('hidden');
  });
</script>

<style>
  .contact{ padding-top:56px; }
  .contact-grid{ display:grid; grid-template-columns:1fr 1fr; gap:64px; }
  @media (max-width:860px){ .contact-grid{ grid-template-columns:1fr; gap:40px; } }
  h1{ font-size:34px; }
  .lede{ color:var(--grey); margin:16px 0 28px; }
  .info-line{ display:flex; gap:14px; padding:14px 0; border-top:1px solid var(--line); font-size:14.5px; }
  .info-line strong{ min-width:100px; color:var(--black); font-family:'Inter',sans-serif; }
  .info-line span{ color:var(--grey); }
  form{ display:flex; flex-direction:column; gap:14px; }
  .row2{ display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  @media (max-width:520px){ .row2{ grid-template-columns:1fr; } }
  input, textarea{
    border:1px solid var(--line); padding:13px 14px; font-family:inherit; font-size:14.5px;
    border-radius:var(--radius); background:var(--tint);
  }
  input:focus, textarea:focus{ outline:2px solid var(--red); outline-offset:1px; background:#fff; }
  textarea{ min-height:110px; resize:vertical; }
  form button{ align-self:flex-start; border:none; cursor:pointer; margin-top:4px; }
  .note{ font-size:12.5px; color:var(--grey); }
</style>
